service fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.1-service-fpc
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    # Without this, init has no way to answer hwservicemanager when a client
    # asks for the HAL before init.oem.fingerprint2.sh has started it:
    #
    #   Could not find 'android.hardware.biometrics.fingerprint@2.1::
    #   IBiometricsFingerprint/default' for ctl.interface_start
    #
    # The service is only started from that script, at late_start, so the
    # framework regularly gets there first. Declaring the interface lets
    # hwservicemanager start it on demand instead of failing the lookup; it
    # still only happens once /data is up, since nothing asks before then.
    interface android.hardware.biometrics.fingerprint@2.1::IBiometricsFingerprint default
    user system
    group system input uhid
    disabled
